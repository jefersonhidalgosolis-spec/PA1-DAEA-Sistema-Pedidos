
@startuml
skinparam componentStyle rectangle

actor "Cliente / Postman" as client

package "sistema-pedidos-springboot (Spring Boot / Port 8081)" {
    component "AnulacionPedidoController\n@RestController" as controller
    component "AnulacionPedidoService\n@Service" as springService
    component "DevolucionStockClient\nRestClient" as httpRestClient
    component "PedidoRepository\nJpaRepository" as pedidoRepo
    component "AnulacionPedidoRepository\nJpaRepository" as anulacionRepo
    database "H2 Database\n(En memoria)" as h2Db
}

package "inventario-service (Jakarta EE / Port 8082)" {
    component "ProductoResource\nJakarta REST" as api
    component "InventarioService\n@Stateless" as service
    component "EntityManager\nJakarta Persistence" as jpa
    database "SQL Server Express 2025\nInventarioDB" as db
}

' Flujo del cliente a Spring Boot
client --> controller : HTTP / JSON\nPOST /api/v1/anulaciones

' Flujo interno en Spring Boot
controller --> springService : Inyección por Constructor
springService --> pedidoRepo : Validar estado REGISTRADO
springService --> anulacionRepo : Validar que no sea duplicado
pedidoRepo --> h2Db : JDBC (H2)
anulacionRepo --> h2Db : JDBC (H2)

' Comunicación entre Microservicios (HTTP / REST)
springService --> httpRestClient : Inyección por Constructor
httpRestClient --> api : HTTP / JSON\nPOST /api/inventario/productos/codigo/{codigo}/devoluciones

' Flujo interno en Jakarta EE
api --> service : @EJB
service --> jpa : @PersistenceContext
jpa --> db : JDBC / InventarioDS
@enduml